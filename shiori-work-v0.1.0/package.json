{
  "name": "shiori-work",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Conversation-first work outer harness with durable state and replaceable CLI runners",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "stop": "node scripts/stop-server.mjs",
    "demo": "node scripts/demo-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:claude": "node scripts/connect-claude.mjs --apply",
    "setup:codex": "node scripts/connect-codex.mjs",
    "smoke:claude": "node scripts/smoke-claude.mjs",
    "smoke:claude:workspace": "node scripts/smoke-claude-workspace.mjs",
    "dev:codex": "node scripts/codex-server.mjs",
    "stop:codex": "node scripts/stop-server.mjs --codex",
    "doctor:codex": "node scripts/probe-codex.mjs",
    "smoke:codex": "node scripts/smoke-codex.mjs",
    "smoke:codex:workspace": "node scripts/smoke-codex-workspace.mjs",
    "preview:build": "node scripts/build-preview.mjs"
  },
  "devDependencies": {
    "@openai/codex": "0.166.0"
  }
}
